{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Market catalog entry or release, version 1",
  "oneOf": [
    { "$ref": "#/$defs/entry" },
    { "$ref": "#/$defs/release" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sha256": {
      "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"
    },
    "date": { "type": "string", "format": "date" },
    "nullableDate": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "nullableText": { "type": ["string", "null"] },
    "nullableId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "manifest_sha256"],
      "properties": {
        "release_id": { "$ref": "#/$defs/id" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "release_id", "manifest_path", "manifest_sha256"],
      "properties": {
        "format": { "const": "market-catalog-entry-1" },
        "release_id": { "$ref": "#/$defs/id" },
        "manifest_path": { "$ref": "#/$defs/path" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification_id", "scheme_name", "version", "source_id",
        "approval_reference", "effective_from", "effective_to"
      ],
      "properties": {
        "classification_id": { "$ref": "#/$defs/id" },
        "scheme_name": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "approval_reference": { "$ref": "#/$defs/id" },
        "effective_from": { "$ref": "#/$defs/date" },
        "effective_to": { "$ref": "#/$defs/nullableDate" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id", "name", "status", "coverage_state", "coverage_description",
        "coverage_as_of", "last_reviewed_at", "classifications"
      ],
      "properties": {
        "region_id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/id" },
        "status": { "enum": ["active", "inactive"] },
        "coverage_state": { "enum": ["complete", "partial", "unverified"] },
        "coverage_description": { "$ref": "#/$defs/id" },
        "coverage_as_of": { "$ref": "#/$defs/date" },
        "last_reviewed_at": { "$ref": "#/$defs/nullableDate" },
        "classifications": {
          "type": "array",
          "items": { "$ref": "#/$defs/classification" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "source_type", "description", "coverage",
        "authority", "approval_reference", "reviewed_at"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "source_type": { "enum": ["local_file", "live"] },
        "description": { "$ref": "#/$defs/id" },
        "coverage": { "$ref": "#/$defs/nullableText" },
        "authority": { "$ref": "#/$defs/nullableText" },
        "approval_reference": { "$ref": "#/$defs/nullableText" },
        "reviewed_at": { "$ref": "#/$defs/nullableDate" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id", "role", "path", "sha256", "required", "row_count",
        "region_id", "classification_id", "classification_version"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "role": {
          "enum": [
            "hierarchy", "stocks", "etf_listings", "sector_etfs", "industry_etfs",
            "sub_industry_etfs", "benchmarks", "audit", "migration_archive",
            "membership_migration"
          ]
        },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "required": { "const": true },
        "row_count": { "type": "integer", "minimum": 0 },
        "region_id": { "$ref": "#/$defs/nullableId" },
        "classification_id": { "$ref": "#/$defs/nullableId" },
        "classification_version": { "$ref": "#/$defs/nullableId" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "stocks" } } },
          "then": { "properties": { "region_id": { "$ref": "#/$defs/id" } } }
        }
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "catalog_type"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "name": { "$ref": "#/$defs/id" },
        "catalog_type": {
          "enum": ["industry", "sector_context", "index_context", "commodity_context"]
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "root", "required", "catalogs"],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "root": { "$ref": "#/$defs/id" },
        "required": { "const": false },
        "catalogs": { "type": "array", "items": { "$ref": "#/$defs/catalog" } }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "release_id", "created_at", "parent_release", "catalog_revision",
        "regions", "evidence_sources", "artifacts", "research_sources"
      ],
      "properties": {
        "format": { "const": "market-catalog-release-1" },
        "release_id": { "$ref": "#/$defs/id" },
        "created_at": {
          "type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"
        },
        "parent_release": { "anyOf": [{ "$ref": "#/$defs/parent" }, { "type": "null" }] },
        "catalog_revision": { "$ref": "#/$defs/sha256" },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
        "evidence_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" },
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": { "role": { "const": "audit" } }
          },
          "maxContains": 1
        },
        "research_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/research" }
        }
      }
    }
  }
}
