{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stocks-speckit.local/schemas/snapshot-manifest.schema.json",
  "title": "Market Leadership Snapshot Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "as_of",
    "built_at",
    "ruleset_version",
    "markets",
    "tables",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "as_of": {"type": "string", "format": "date"},
    "built_at": {"type": "string", "format": "date-time"},
    "ruleset_version": {"type": "string", "minLength": 1},
    "markets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "rows", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^[^/].*\\.parquet$"},
          "rows": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "name", "dataset", "version", "retrieved_at", "checksum"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "dataset": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "license_label": {"type": ["string", "null"]},
          "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}